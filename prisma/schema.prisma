generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OperationStatus {
  ASSIGNMENT_NEEDED  @map("assignment_needed")
  ASSIGNMENT_PLANNED @map("assignment_planned")
  ACTIVE             @map("active")
  DONE               @map("done")
  RETROSPECTIVE_DONE @map("retrospective_done")
  ARCHIVE_NEEDED     @map("archive_needed")

  @@map("operation_status")
}

enum ArchiveStatus {
  NOT_READY @map("not_ready")
  NEEDED    @map("needed")
  DONE      @map("done")

  @@map("archive_status")
}

enum EducationFormat {
  OFFLINE      @map("offline")
  REMOTE       @map("remote")
  BLENDED      @map("blended")
  FLIPPED      @map("flipped")
  NEEDS_REVIEW @map("needs_review")

  @@map("education_format")
}

enum OperationChannel {
  ONSITE          @map("onsite")
  LIVE_ONLINE     @map("live_online")
  ONLINE_PLATFORM @map("online_platform")
  BLENDED         @map("blended")
  NEEDS_REVIEW    @map("needs_review")

  @@map("operation_channel")
}

enum OperationType {
  LECTURE       @map("lecture")
  SHORT         @map("short")
  MEDIUM        @map("medium")
  MID_TERM_LONG @map("mid_term_long")
  MID_LONG      @map("mid_long")
  LONG          @map("long")
  ANNUAL        @map("annual")
  ALWAYS_ON     @map("always_on")
  NEEDS_REVIEW  @map("needs_review")

  @@map("operation_type")
}

enum OnsiteRequired {
  Y
  N
  PARTIAL
  UNKNOWN

  @@map("onsite_required")
}

enum ResultReportStatus {
  YES           @map("yes")
  NO            @map("no")
  NOT_REQUIRED  @map("not_required")
  NEEDS_REVIEW  @map("needs_review")

  @@map("result_report_status")
}

enum ImportStatus {
  PENDING               @map("pending")
  COMPLETED             @map("completed")
  COMPLETED_WITH_ERRORS @map("completed_with_errors")
  FAILED                @map("failed")

  @@map("import_status")
}

enum SourceTeam {
  TEAM_1  @map("team_1")
  TEAM_2  @map("team_2")
  UNKNOWN @map("unknown")

  @@map("source_team")
}

enum MemberRole {
  OM @map("om")
  LD @map("ld")

  @@map("member_role")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@map("companies")
}

model Course {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  courseId      String        @map("course_id")
  name          String        @map("course_name")
  operationType OperationType @default(NEEDS_REVIEW) @map("operation_type")
  revenue       Decimal?      @db.Decimal(14, 2)
  revenueRaw    String?       @map("revenue_raw")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  company  Company           @relation(fields: [companyId], references: [id])
  sessions OperationSession[]

  @@unique([companyId, courseId, name])
  @@index([courseId])
  @@map("courses")
}

model OperationSession {
  id                    String             @id @default(uuid()) @db.Uuid
  operationId           String             @unique @map("operation_id")
  courseRecordId        String             @map("course_record_id") @db.Uuid
  sourceFingerprint     String?            @unique @map("source_fingerprint")
  validationErrors      Json?              @map("validation_errors")
  operationStatus       OperationStatus    @default(ASSIGNMENT_NEEDED) @map("operation_status")
  archiveStatus         ArchiveStatus      @default(NOT_READY) @map("archive_status")
  educationFormat       EducationFormat    @default(NEEDS_REVIEW) @map("education_format")
  educationFormatRaw    String?            @map("education_format_raw")
  operationChannel      OperationChannel   @default(NEEDS_REVIEW) @map("operation_channel")
  roundNo               String?            @map("round_no")
  educationDays         String?            @map("education_days")
  startDate             DateTime           @map("start_date") @db.Date
  endDate               DateTime           @map("end_date") @db.Date
  operationMonth        String?            @map("operation_month")
  sessionDurationDays   Int?               @map("session_duration_days")
  sessionDurationType   OperationType?     @map("session_duration_type")
  timeText              String?            @map("time_text")
  omName                String?            @map("om_name")
  ldName                String?            @map("ld_name")
  instructorsText       String?            @map("instructors_text")
  coachText             String?            @map("coach_text")
  region                String?
  onsiteRequired        OnsiteRequired     @default(UNKNOWN) @map("onsite_required")
  onsiteText            String?            @map("onsite_text")
  specialNotes          String?            @map("special_notes")
  operationIssue        String?            @map("operation_issue")
  omUpdate              String?            @map("om_update")
  driveLink             String?            @map("drive_link")
  operationDetail       String?            @map("operation_detail")
  companyWikiLink       String?            @map("company_wiki_link")
  instructorWikiLink    String?            @map("instructor_wiki_link")
  costRaw               String?            @map("cost_raw")
  profitRaw             String?            @map("profit_raw")
  totalCost             Decimal?           @map("total_cost") @db.Decimal(14, 2)
  instructorCost        Decimal?           @map("instructor_cost") @db.Decimal(14, 2)
  operationCost         Decimal?           @map("operation_cost") @db.Decimal(14, 2)
  avgSatisfaction       String?            @map("avg_satisfaction")
  instructorSatisfaction String?           @map("instructor_satisfaction")
  hasResultReport       ResultReportStatus @default(NEEDS_REVIEW) @map("has_result_report")
  resultReportLink      String?            @map("result_report_link")
  lectureManagementLink String?            @map("lecture_management_link")
  padletLink            String?            @map("padlet_link")
  createdBy             String?            @map("created_by")
  updatedBy             String?            @map("updated_by")
  omUserId              String?            @map("om_user_id")
  ldUserId              String?            @map("ld_user_id")
  deletedAt             DateTime?          @map("deleted_at")
  deletedBy             String?            @map("deleted_by")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  course        Course                  @relation(fields: [courseRecordId], references: [id])
  sourceRecords OperationSourceRecord[]
  driveImportResults DriveImportResult[]
  coachEngagements   CoachEngagement[]

  @@index([courseRecordId])
  @@index([operationStatus])
  @@index([archiveStatus])
  @@index([startDate])
  @@index([omUserId])
  @@index([ldUserId])
  @@map("operation_sessions")
}

model DriveImportRun {
  id                           String       @id @default(uuid()) @db.Uuid
  mode                         String       @default("dry_run")
  status                       ImportStatus @default(PENDING)
  operationCount               Int          @default(0) @map("operation_count")
  scannedRefCount              Int          @default(0) @map("scanned_ref_count")
  scanFoundFolderCount         Int          @default(0) @map("scan_found_folder_count")
  scanIssueCount               Int          @default(0) @map("scan_issue_count")
  folderSearchCount            Int          @default(0) @map("folder_search_count")
  folderSearchWithCandidatesCount Int       @default(0) @map("folder_search_with_candidates_count")
  avgSatisfactionCandidateCount Int         @default(0) @map("avg_satisfaction_candidate_count")
  instructorSatisfactionCandidateCount Int  @default(0) @map("instructor_satisfaction_candidate_count")
  instructorCandidateCount     Int          @default(0) @map("instructor_candidate_count")
  suspiciousCandidateCount     Int          @default(0) @map("suspicious_candidate_count")
  errorCount                   Int          @default(0) @map("error_count")
  summary                      Json?
  notes                        String?
  startedAt                    DateTime     @default(now()) @map("started_at")
  finishedAt                   DateTime?    @map("finished_at")

  results DriveImportResult[]

  @@index([startedAt])
  @@index([status])
  @@map("drive_import_runs")
}

model DriveImportResult {
  id                 String   @id @default(uuid()) @db.Uuid
  runId              String   @map("run_id") @db.Uuid
  operationSessionId String?  @map("operation_session_id") @db.Uuid
  operationId        String   @map("operation_id")
  companyName        String   @map("company_name")
  courseName         String   @map("course_name")
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  inputKind          String   @map("input_kind")
  inputValue         String?  @map("input_value")
  resultKind         String   @map("result_kind")
  folderId           String?  @map("folder_id")
  folderTitle        String?  @map("folder_title")
  folderUrl          String?  @map("folder_url")
  fileCount          Int      @default(0) @map("file_count")
  candidateCount     Int      @default(0) @map("candidate_count")
  keyCandidates      Json?    @map("key_candidates")
  folderCandidates   Json?    @map("folder_candidates")
  issues             Json?
  error              String?
  createdAt          DateTime @default(now()) @map("created_at")

  run DriveImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  operationSession OperationSession? @relation(fields: [operationSessionId], references: [id])

  @@index([runId])
  @@index([operationSessionId])
  @@index([operationId])
  @@index([resultKind])
  @@map("drive_import_results")
}

model Member {
  id             String     @id @default(uuid()) @db.Uuid
  role           MemberRole?
  sourceTeam     SourceTeam? @map("source_team")
  name           String
  normalizedName String     @map("normalized_name")
  roleTitle      String?    @map("role_title")
  calendarId     String?    @map("calendar_id")
  isActive       Boolean    @default(true) @map("is_active")
  displayOrder   Int?       @map("display_order")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@unique([role, sourceTeam, normalizedName])
  @@index([sourceTeam, isActive])
  @@index([role, sourceTeam, isActive])
  @@map("members")
}

model DataImportRun {
  id             String       @id @default(uuid()) @db.Uuid
  sourceTeam     SourceTeam   @default(UNKNOWN) @map("source_team")
  sourceType     String       @map("source_type")
  sourceName     String       @map("source_name")
  workbookName   String?      @map("workbook_name")
  fileName       String?      @map("file_name")
  status         ImportStatus @default(PENDING)
  rowCount       Int          @default(0) @map("row_count")
  successCount   Int          @default(0) @map("success_count")
  errorCount     Int          @default(0) @map("error_count")
  importedBy     String?      @map("imported_by")
  startedAt      DateTime     @default(now()) @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  notes          String?
  validationLogs Json?        @map("validation_logs")

  sourceRecords OperationSourceRecord[]

  @@index([sourceTeam])
  @@index([sourceType])
  @@index([startedAt])
  @@map("data_import_runs")
}

model OperationSourceRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  importRunId        String            @map("import_run_id") @db.Uuid
  operationSessionId String?           @map("operation_session_id") @db.Uuid
  sourceTeam         SourceTeam        @default(UNKNOWN) @map("source_team")
  sourceWorkbook     String            @map("source_workbook")
  sourceSheet        String            @map("source_sheet")
  sourceRowNumber    Int               @map("source_row_number")
  headerRowNumber    Int?              @map("header_row_number")
  sourceFingerprint  String?           @map("source_fingerprint")
  rowSnapshot        Json              @map("row_snapshot")
  mappedFields       Json?             @map("mapped_fields")
  unmappedFields     Json?             @map("unmapped_fields")
  validationErrors   Json?             @map("validation_errors")
  createdAt          DateTime          @default(now()) @map("created_at")

  importRun        DataImportRun      @relation(fields: [importRunId], references: [id])
  operationSession OperationSession?  @relation(fields: [operationSessionId], references: [id])

  @@unique([importRunId, sourceSheet, sourceRowNumber])
  @@index([operationSessionId])
  @@index([sourceTeam])
  @@index([sourceSheet])
  @@index([sourceFingerprint])
  @@map("operation_source_records")
}

enum CoachStatus {
  PENDING  @map("pending")
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("coach_status")
}

enum CoachEngagementStatus {
  SCHEDULED   @map("scheduled")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")

  @@map("coach_engagement_status")
}

enum CoachEngagementSource {
  SHEET  @map("sheet")
  MANUAL @map("manual")

  @@map("coach_engagement_source")
}

model Coach {
  id             String      @id @default(uuid()) @db.Uuid
  sourceCoachId  String      @unique @map("source_coach_id")
  name           String      // 운영상 식별자 (무분별 노출 금지)
  normalizedName String      @map("normalized_name")
  workType       String?     @map("work_type")
  status         CoachStatus @default(ACTIVE) // coach-db 활동 상태
  isActive       Boolean     @default(true) @map("is_active") // hub-om 운영 노출 여부 (status와 의미 분리)
  displayOrder   Int?        @map("display_order")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  privateProfile      CoachPrivateProfile?
  fields              CoachField[]
  curriculums         CoachCurriculum[]
  schedules           CoachSchedule[]
  engagements         CoachEngagement[]
  engagementSchedules CoachEngagementSchedule[]

  @@index([normalizedName])
  @@index([status, isActive])
  @@map("coaches")
}

model CoachPrivateProfile {
  coachId     String    @id @map("coach_id") @db.Uuid
  employeeId  String?   @map("employee_id")
  phone       String?
  email       String?
  birthDate   DateTime? @map("birth_date") @db.Date
  affiliation String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@map("coach_private_profiles")
}

model CoachFieldMaster {
  id      String       @id @default(uuid()) @db.Uuid
  name    String       @unique
  coaches CoachField[]

  @@map("coach_field_masters")
}

model CoachCurriculumMaster {
  id      String            @id @default(uuid()) @db.Uuid
  name    String            @unique
  coaches CoachCurriculum[]

  @@map("coach_curriculum_masters")
}

model CoachField {
  coachId String @map("coach_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  coach   Coach            @relation(fields: [coachId], references: [id], onDelete: Cascade)
  tag     CoachFieldMaster @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([coachId, tagId])
  @@map("coach_fields")
}

model CoachCurriculum {
  coachId String @map("coach_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  coach   Coach                 @relation(fields: [coachId], references: [id], onDelete: Cascade)
  tag     CoachCurriculumMaster @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([coachId, tagId])
  @@map("coach_curriculums")
}

model CoachSchedule {
  id               String   @id @default(uuid()) @db.Uuid
  sourceScheduleId String   @unique @map("source_schedule_id")
  coachId          String   @map("coach_id") @db.Uuid
  date             DateTime @db.Date
  startTime        String   @map("start_time")
  endTime          String   @map("end_time")
  updatedAt        DateTime @updatedAt @map("updated_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, date])
  @@map("coach_schedules")
}

model CoachEngagement {
  id                 String                @id @default(uuid()) @db.Uuid
  sourceEngagementId String                @unique @map("source_engagement_id")
  coachId            String                @map("coach_id") @db.Uuid
  operationSessionId String?               @map("operation_session_id") @db.Uuid
  courseName         String                @map("course_name")
  status             CoachEngagementStatus @default(SCHEDULED)
  source             CoachEngagementSource @default(MANUAL)
  startDate          DateTime              @map("start_date") @db.Date
  endDate            DateTime              @map("end_date") @db.Date
  startTime          String?               @map("start_time")
  endTime            String?               @map("end_time")
  rating             Int?                  @db.SmallInt
  rehire             Boolean?
  feedback           String?               // private 성격 강함 → admin 전용
  hiredById          String?               @map("hired_by_id")
  hiredByText        String?               @map("hired_by_text") // private 취급
  createdAt          DateTime              @default(now()) @map("created_at")

  coach            Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  operationSession OperationSession? @relation(fields: [operationSessionId], references: [id])
  schedules        CoachEngagementSchedule[]

  @@index([coachId])
  @@index([operationSessionId])
  @@map("coach_engagements")
}

model CoachEngagementSchedule {
  id                         String    @id @default(uuid()) @db.Uuid
  sourceEngagementScheduleId String    @unique @map("source_engagement_schedule_id")
  engagementId               String    @map("engagement_id") @db.Uuid
  coachId                    String    @map("coach_id") @db.Uuid
  date                       DateTime  @db.Date
  startTime                  String    @map("start_time")
  endTime                    String    @map("end_time")
  cancelledAt                DateTime? @map("cancelled_at")

  engagement CoachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  coach      Coach           @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, date])
  @@index([date])
  @@map("coach_engagement_schedules")
}

model CoachImportRun {
  id                    String       @id @default(uuid()) @db.Uuid
  mode                  String       @default("dry_run")
  status                ImportStatus @default(PENDING)
  coachCount            Int          @default(0) @map("coach_count")
  engagementCount       Int          @default(0) @map("engagement_count")
  scheduleCount         Int          @default(0) @map("schedule_count")
  matchedOperationCount Int          @default(0) @map("matched_operation_count")
  errorCount            Int          @default(0) @map("error_count")
  summary               Json?
  notes                 String?
  startedAt             DateTime     @default(now()) @map("started_at")
  finishedAt            DateTime?    @map("finished_at")

  @@index([startedAt])
  @@map("coach_import_runs")
}
