generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OperationStatus {
  ASSIGNMENT_NEEDED  @map("assignment_needed")
  ASSIGNMENT_PLANNED @map("assignment_planned")
  ACTIVE             @map("active")
  DONE               @map("done")
  RETROSPECTIVE_DONE @map("retrospective_done")
  ARCHIVE_NEEDED     @map("archive_needed")

  @@map("operation_status")
}

enum ArchiveStatus {
  NOT_READY @map("not_ready")
  NEEDED    @map("needed")
  DONE      @map("done")

  @@map("archive_status")
}

enum EducationFormat {
  OFFLINE      @map("offline")
  REMOTE       @map("remote")
  BLENDED      @map("blended")
  FLIPPED      @map("flipped")
  NEEDS_REVIEW @map("needs_review")

  @@map("education_format")
}

enum OperationChannel {
  ONSITE          @map("onsite")
  LIVE_ONLINE     @map("live_online")
  ONLINE_PLATFORM @map("online_platform")
  BLENDED         @map("blended")
  NEEDS_REVIEW    @map("needs_review")

  @@map("operation_channel")
}

enum OperationType {
  LECTURE       @map("lecture")
  SHORT         @map("short")
  MEDIUM        @map("medium")
  MID_TERM_LONG @map("mid_term_long")
  MID_LONG      @map("mid_long")
  LONG          @map("long")
  ANNUAL        @map("annual")
  ALWAYS_ON     @map("always_on")
  NEEDS_REVIEW  @map("needs_review")

  @@map("operation_type")
}

enum OnsiteRequired {
  Y
  N
  PARTIAL
  UNKNOWN

  @@map("onsite_required")
}

enum ResultReportStatus {
  YES           @map("yes")
  NO            @map("no")
  NOT_REQUIRED  @map("not_required")
  NEEDS_REVIEW  @map("needs_review")

  @@map("result_report_status")
}

enum ImportStatus {
  PENDING               @map("pending")
  COMPLETED             @map("completed")
  COMPLETED_WITH_ERRORS @map("completed_with_errors")
  FAILED                @map("failed")

  @@map("import_status")
}

enum SourceTeam {
  TEAM_1  @map("team_1")
  TEAM_2  @map("team_2")
  UNKNOWN @map("unknown")

  @@map("source_team")
}

enum MemberRole {
  OM @map("om")
  LD @map("ld")

  @@map("member_role")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@map("companies")
}

model Course {
  id            String        @id @default(uuid()) @db.Uuid
  // hub-om이 직접 채번하는 "과정ID"(화면에는 PRC-000123처럼 노출, formatProcessId 참고).
  // 코스ID(courseId)는 사내 다른 시스템이 나중에 채워 넣는 값이라 요청 시점엔 비어있을 수
  // 있지만, processSeq는 과정(Course) 행이 생기는 즉시 DB가 채번하므로 항상 존재한다.
  processSeq    Int           @unique @default(autoincrement()) @map("process_seq")
  companyId     String        @map("company_id") @db.Uuid
  courseId      String        @map("course_id")
  name          String        @map("course_name")
  operationType OperationType @default(NEEDS_REVIEW) @map("operation_type")
  revenue       Decimal?      @db.Decimal(14, 2)
  revenueRaw    String?       @map("revenue_raw")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  company  Company           @relation(fields: [companyId], references: [id])
  sessions OperationSession[]

  @@unique([companyId, courseId, name])
  @@index([courseId])
  @@map("courses")
}

model OperationSession {
  id                    String             @id @default(uuid()) @db.Uuid
  operationId           String             @unique @map("operation_id")
  courseRecordId        String             @map("course_record_id") @db.Uuid
  sourceFingerprint     String?            @unique @map("source_fingerprint")
  validationErrors      Json?              @map("validation_errors")
  operationStatus       OperationStatus    @default(ASSIGNMENT_NEEDED) @map("operation_status")
  archiveStatus         ArchiveStatus      @default(NOT_READY) @map("archive_status")
  educationFormat       EducationFormat    @default(NEEDS_REVIEW) @map("education_format")
  educationFormatRaw    String?            @map("education_format_raw")
  operationChannel      OperationChannel   @default(NEEDS_REVIEW) @map("operation_channel")
  roundNo               String?            @map("round_no")
  educationDays         String?            @map("education_days")
  startDate             DateTime           @map("start_date") @db.Date
  endDate               DateTime           @map("end_date") @db.Date
  operationMonth        String?            @map("operation_month")
  sessionDurationDays   Int?               @map("session_duration_days")
  sessionDurationType   OperationType?     @map("session_duration_type")
  timeText              String?            @map("time_text")
  omName                String?            @map("om_name")
  ldName                String?            @map("ld_name")
  instructorsText       String?            @map("instructors_text")
  coachText             String?            @map("coach_text")
  region                String?
  onsiteRequired        OnsiteRequired     @default(UNKNOWN) @map("onsite_required")
  onsiteText            String?            @map("onsite_text")
  onsiteOmName          String?            @map("onsite_om_name")
  specialNotes          String?            @map("special_notes")
  operationIssue        String?            @map("operation_issue")
  omUpdate              String?            @map("om_update")
  driveLink             String?            @map("drive_link")
  operationDetail       String?            @map("operation_detail")
  companyWikiLink       String?            @map("company_wiki_link")
  instructorWikiLink    String?            @map("instructor_wiki_link")
  costRaw               String?            @map("cost_raw")
  profitRaw             String?            @map("profit_raw")
  totalCost             Decimal?           @map("total_cost") @db.Decimal(14, 2)
  instructorCost        Decimal?           @map("instructor_cost") @db.Decimal(14, 2)
  operationCost         Decimal?           @map("operation_cost") @db.Decimal(14, 2)
  avgSatisfaction       String?            @map("avg_satisfaction")
  instructorSatisfaction String?           @map("instructor_satisfaction")
  hasResultReport       ResultReportStatus @default(NEEDS_REVIEW) @map("has_result_report")
  resultReportLink      String?            @map("result_report_link")
  lectureManagementLink String?            @map("lecture_management_link")
  lectureManagementNote String?            @map("lecture_management_note")
  padletLink            String?            @map("padlet_link")
  createdBy             String?            @map("created_by")
  updatedBy             String?            @map("updated_by")
  omUserId              String?            @map("om_user_id")
  ldUserId              String?            @map("ld_user_id")
  deletedAt             DateTime?          @map("deleted_at")
  deletedBy             String?            @map("deleted_by")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  course        Course                  @relation(fields: [courseRecordId], references: [id])
  sourceRecords OperationSourceRecord[]
  driveImportResults DriveImportResult[]
  coachEngagements   CoachEngagement[]

  @@index([courseRecordId])
  @@index([operationStatus])
  @@index([archiveStatus])
  @@index([startDate])
  @@index([omUserId])
  @@index([ldUserId])
  @@map("operation_sessions")
}

// 업무 요청(om-request) 접수 창구. 접수 시점에 courseId 없이 Course/OperationSession을
// 자동 생성하고 그 operationId를 여기 저장한다(참조는 문자열 키만 두고 FK는 걸지 않음 —
// 이 앱 전체가 courseId/operationId를 느슨한 join key로 다루는 방식과 동일하게 맞춤).
// 생성 이후 운영현황 쪽 값이 최종본이며, 이 테이블 수정이 운영현황에 자동 반영되지는 않는다
// (배정된 OM만 예외적으로 동기화한다. omRequestOperationLink.ts 참고).
model OmRequest {
  id                  String   @id @default(cuid())
  assignedOm          String?  @map("assigned_om")
  operationId         String?  @map("operation_id")
  team                String
  ld                  String
  company             String
  businessNumber      String?  @map("business_number")
  trainingType        String   @map("training_type")
  courseId            String   @map("course_id")
  courseName          String   @map("course_name")
  courseCategoryMajor String?  @map("course_category_major")
  courseCategory      String   @map("course_category")
  tools               String?
  instructorName      String   @map("instructor_name")
  syncupLink          String   @map("syncup_link")
  driveLink           String   @map("drive_link")
  skillfloSetup       String   @map("skillflo_setup")
  skillmatchSetup     String   @map("skillmatch_setup")
  onSiteOperation     String   @map("on_site_operation")
  coachRequest        String   @map("coach_request")
  totalSessions       Int      @map("total_sessions")
  sessions            Json
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([operationId])
  @@index([assignedOm])
  @@map("om_requests")
}

model DriveImportRun {
  id                           String       @id @default(uuid()) @db.Uuid
  mode                         String       @default("dry_run")
  status                       ImportStatus @default(PENDING)
  operationCount               Int          @default(0) @map("operation_count")
  scannedRefCount              Int          @default(0) @map("scanned_ref_count")
  scanFoundFolderCount         Int          @default(0) @map("scan_found_folder_count")
  scanIssueCount               Int          @default(0) @map("scan_issue_count")
  folderSearchCount            Int          @default(0) @map("folder_search_count")
  folderSearchWithCandidatesCount Int       @default(0) @map("folder_search_with_candidates_count")
  avgSatisfactionCandidateCount Int         @default(0) @map("avg_satisfaction_candidate_count")
  instructorSatisfactionCandidateCount Int  @default(0) @map("instructor_satisfaction_candidate_count")
  instructorCandidateCount     Int          @default(0) @map("instructor_candidate_count")
  suspiciousCandidateCount     Int          @default(0) @map("suspicious_candidate_count")
  errorCount                   Int          @default(0) @map("error_count")
  summary                      Json?
  notes                        String?
  startedAt                    DateTime     @default(now()) @map("started_at")
  finishedAt                   DateTime?    @map("finished_at")

  results DriveImportResult[]

  @@index([startedAt])
  @@index([status])
  @@map("drive_import_runs")
}

model DriveImportResult {
  id                 String   @id @default(uuid()) @db.Uuid
  runId              String   @map("run_id") @db.Uuid
  operationSessionId String?  @map("operation_session_id") @db.Uuid
  operationId        String   @map("operation_id")
  companyName        String   @map("company_name")
  courseName         String   @map("course_name")
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  inputKind          String   @map("input_kind")
  inputValue         String?  @map("input_value")
  resultKind         String   @map("result_kind")
  folderId           String?  @map("folder_id")
  folderTitle        String?  @map("folder_title")
  folderUrl          String?  @map("folder_url")
  fileCount          Int      @default(0) @map("file_count")
  candidateCount     Int      @default(0) @map("candidate_count")
  keyCandidates      Json?    @map("key_candidates")
  folderCandidates   Json?    @map("folder_candidates")
  issues             Json?
  error              String?
  createdAt          DateTime @default(now()) @map("created_at")

  run DriveImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  operationSession OperationSession? @relation(fields: [operationSessionId], references: [id])

  @@index([runId])
  @@index([operationSessionId])
  @@index([operationId])
  @@index([resultKind])
  @@map("drive_import_results")
}

model Member {
  id             String     @id @default(uuid()) @db.Uuid
  role           MemberRole?
  sourceTeam     SourceTeam? @map("source_team")
  name           String
  normalizedName String     @map("normalized_name")
  roleTitle      String?    @map("role_title")
  calendarId     String?    @map("calendar_id")
  isActive       Boolean    @default(true) @map("is_active")
  displayOrder   Int?       @map("display_order")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@unique([role, sourceTeam, normalizedName])
  @@index([sourceTeam, isActive])
  @@index([role, sourceTeam, isActive])
  @@map("members")
}

model DataImportRun {
  id             String       @id @default(uuid()) @db.Uuid
  sourceTeam     SourceTeam   @default(UNKNOWN) @map("source_team")
  sourceType     String       @map("source_type")
  sourceName     String       @map("source_name")
  workbookName   String?      @map("workbook_name")
  fileName       String?      @map("file_name")
  status         ImportStatus @default(PENDING)
  rowCount       Int          @default(0) @map("row_count")
  successCount   Int          @default(0) @map("success_count")
  errorCount     Int          @default(0) @map("error_count")
  importedBy     String?      @map("imported_by")
  startedAt      DateTime     @default(now()) @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  notes          String?
  validationLogs Json?        @map("validation_logs")

  sourceRecords OperationSourceRecord[]

  @@index([sourceTeam])
  @@index([sourceType])
  @@index([startedAt])
  @@map("data_import_runs")
}

model OperationSourceRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  importRunId        String            @map("import_run_id") @db.Uuid
  operationSessionId String?           @map("operation_session_id") @db.Uuid
  sourceTeam         SourceTeam        @default(UNKNOWN) @map("source_team")
  sourceWorkbook     String            @map("source_workbook")
  sourceSheet        String            @map("source_sheet")
  sourceRowNumber    Int               @map("source_row_number")
  headerRowNumber    Int?              @map("header_row_number")
  sourceFingerprint  String?           @map("source_fingerprint")
  rowSnapshot        Json              @map("row_snapshot")
  mappedFields       Json?             @map("mapped_fields")
  unmappedFields     Json?             @map("unmapped_fields")
  validationErrors   Json?             @map("validation_errors")
  createdAt          DateTime          @default(now()) @map("created_at")

  importRun        DataImportRun      @relation(fields: [importRunId], references: [id])
  operationSession OperationSession?  @relation(fields: [operationSessionId], references: [id])

  @@unique([importRunId, sourceSheet, sourceRowNumber])
  @@index([operationSessionId])
  @@index([sourceTeam])
  @@index([sourceSheet])
  @@index([sourceFingerprint])
  @@map("operation_source_records")
}

enum CoachStatus {
  PENDING  @map("pending")
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("coach_status")
}

enum CoachEngagementStatus {
  SCHEDULED   @map("scheduled")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")

  @@map("coach_engagement_status")
}

enum CoachEngagementSource {
  SHEET  @map("sheet")
  MANUAL @map("manual")

  @@map("coach_engagement_source")
}

model Coach {
  id             String      @id @default(uuid()) @db.Uuid
  sourceCoachId  String      @unique @map("source_coach_id")
  accessToken    String?     @unique @map("access_token")
  name           String      // 운영상 식별자 (무분별 노출 금지)
  normalizedName String      @map("normalized_name")
  workType       String?     @map("work_type")
  status         CoachStatus @default(ACTIVE) // coach-db 활동 상태
  statusNote     String?     @map("status_note")
  returnDate     DateTime?   @map("return_date") @db.Date
  selfNote       String?     @map("self_note")
  portfolioUrl   String?     @map("portfolio_url")
  availabilityDetail String? @map("availability_detail")
  managerNote    String?     @map("manager_note")
  dxTag          String?     @map("dx_tag")
  notionPageId   String?     @map("notion_page_id") // 노션 코치 DB의 해당 코치 페이지 ID (바로가기 링크용)
  isActive       Boolean     @default(true) @map("is_active") // hub-om 운영 노출 여부 (status와 의미 분리)
  displayOrder   Int?        @map("display_order")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")
  deletedBy      String?     @map("deleted_by")

  privateProfile      CoachPrivateProfile?
  fields              CoachField[]
  curriculums         CoachCurriculum[]
  schedules           CoachSchedule[]
  engagements         CoachEngagement[]
  engagementSchedules CoachEngagementSchedule[]
  privateAccessLogs   CoachPrivateAccessLog[]
  scheduleAccessLogs  CoachScheduleAccessLog[]
  dayReservations     CoachDayReservation[]
  contentEntries      CoachContentEntry[]

  @@index([normalizedName])
  @@index([status, isActive])
  @@map("coaches")
}

enum CoachContentEntryKind {
  NOTE
  EDIT_HISTORY
}

model CoachContentEntry {
  id          String                 @id @default(uuid()) @db.Uuid
  coachId     String                 @map("coach_id") @db.Uuid
  kind        CoachContentEntryKind
  content     String
  authorEmail String?                @map("author_email")
  authorName  String?                @map("author_name")
  sourceField String?                @map("source_field") // 수정이력용: 변경된 필드 식별자 (예: coaches.managerNote)
  flaggedAt   DateTime?              @map("flagged_at") // 메모 "경고" 표시
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  deletedAt   DateTime?              @map("deleted_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([kind])
  @@map("coach_content_entries")
}

model CoachPrivateAccessLog {
  id              String   @id @default(uuid()) @db.Uuid
  coachId         String   @map("coach_id") @db.Uuid
  accessedByEmail String   @map("accessed_by_email")
  accessedAt      DateTime @default(now()) @map("accessed_at")
  context         String?  // 예: "coach_detail", "engagement_feedback"
  coach           Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, accessedAt])
  @@index([accessedByEmail, accessedAt])
  @@map("coach_private_access_logs")
}

model CoachPrivateProfile {
  coachId     String    @id @map("coach_id") @db.Uuid
  employeeId  String?   @map("employee_id")
  phone       String?
  email       String?
  birthDate   DateTime? @map("birth_date") @db.Date
  affiliation String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@map("coach_private_profiles")
}

model CoachFieldMaster {
  id      String       @id @default(uuid()) @db.Uuid
  name    String       @unique
  coaches CoachField[]

  @@map("coach_field_masters")
}

model CoachCurriculumMaster {
  id      String            @id @default(uuid()) @db.Uuid
  name    String            @unique
  coaches CoachCurriculum[]

  @@map("coach_curriculum_masters")
}

model CoachField {
  coachId String @map("coach_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  coach   Coach            @relation(fields: [coachId], references: [id], onDelete: Cascade)
  tag     CoachFieldMaster @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([coachId, tagId])
  @@map("coach_fields")
}

model CoachCurriculum {
  coachId String @map("coach_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  coach   Coach                 @relation(fields: [coachId], references: [id], onDelete: Cascade)
  tag     CoachCurriculumMaster @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([coachId, tagId])
  @@map("coach_curriculums")
}

model CoachSchedule {
  id               String   @id @default(uuid()) @db.Uuid
  sourceScheduleId String   @unique @map("source_schedule_id")
  coachId          String   @map("coach_id") @db.Uuid
  date             DateTime @db.Date
  startTime        String   @map("start_time")
  endTime          String   @map("end_time")
  updatedAt        DateTime @updatedAt @map("updated_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, date])
  @@map("coach_schedules")
}

// 코치 일정 화면에서 매니저들이 같은 코치·날짜에 중복으로 연락하지 않도록
// 남기는 가벼운 예약(선점) 표시. 실제 투입 확정 기록은 CoachEngagement가 담당한다.
model CoachDayReservation {
  id              String    @id @default(uuid()) @db.Uuid
  coachId         String    @map("coach_id") @db.Uuid
  date            DateTime  @db.Date
  reservedByEmail String    @map("reserved_by_email")
  reservedByName  String    @map("reserved_by_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  cancelledAt     DateTime? @map("cancelled_at")

  // 예약이 실제 투입 확정으로 이어져 자동 취소된 경우, 그 확정 건을 가리킨다.
  // (마이페이지의 "확정된 과정" 목록에 과정명·기간·코치를 보여주는 데 사용)
  confirmedEngagementId String? @map("confirmed_engagement_id") @db.Uuid

  coach               Coach            @relation(fields: [coachId], references: [id], onDelete: Cascade)
  confirmedEngagement CoachEngagement? @relation(fields: [confirmedEngagementId], references: [id], onDelete: SetNull)

  @@index([coachId, date])
  @@index([confirmedEngagementId])
  @@map("coach_day_reservations")
}

model CoachScheduleAccessLog {
  id                String    @id @default(uuid()) @db.Uuid
  sourceAccessLogId String?   @unique @map("source_access_log_id")
  coachId           String    @map("coach_id") @db.Uuid
  yearMonth         String    @map("year_month")
  accessedAt        DateTime  @default(now()) @map("accessed_at")
  lastEditedAt      DateTime? @map("last_edited_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, yearMonth])
  @@index([yearMonth])
  @@map("coach_schedule_access_logs")
}

model CoachEngagement {
  id                 String                @id @default(uuid()) @db.Uuid
  sourceEngagementId String                @unique @map("source_engagement_id")
  coachId            String                @map("coach_id") @db.Uuid
  operationSessionId String?               @map("operation_session_id") @db.Uuid
  courseName         String                @map("course_name")
  status             CoachEngagementStatus @default(SCHEDULED)
  source             CoachEngagementSource @default(MANUAL)
  startDate          DateTime              @map("start_date") @db.Date
  endDate            DateTime              @map("end_date") @db.Date
  startTime          String?               @map("start_time")
  endTime            String?               @map("end_time")
  rating             Int?                  @db.SmallInt
  rehire             Boolean?
  feedback           String?               // private 성격 강함 → admin 전용
  reviewFlaggedAt    DateTime?             @map("review_flagged_at") // 콘텐츠 관리 탭의 리뷰 "경고" 표시
  hiredById          String?               @map("hired_by_id")
  hiredByText        String?               @map("hired_by_text") // private 취급
  createdAt          DateTime              @default(now()) @map("created_at")

  coach              Coach                 @relation(fields: [coachId], references: [id], onDelete: Cascade)
  operationSession   OperationSession?     @relation(fields: [operationSessionId], references: [id])
  schedules          CoachEngagementSchedule[]
  confirmedFromReservations CoachDayReservation[]

  @@index([coachId])
  @@index([operationSessionId])
  @@map("coach_engagements")
}

model CoachEngagementSchedule {
  id                         String    @id @default(uuid()) @db.Uuid
  sourceEngagementScheduleId String    @unique @map("source_engagement_schedule_id")
  engagementId               String    @map("engagement_id") @db.Uuid
  coachId                    String    @map("coach_id") @db.Uuid
  date                       DateTime  @db.Date
  startTime                  String    @map("start_time")
  endTime                    String    @map("end_time")
  cancelledAt                DateTime? @map("cancelled_at")

  engagement CoachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  coach      Coach           @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, date])
  @@index([date])
  @@map("coach_engagement_schedules")
}

model CoachImportRun {
  id                    String       @id @default(uuid()) @db.Uuid
  mode                  String       @default("dry_run")
  status                ImportStatus @default(PENDING)
  coachCount            Int          @default(0) @map("coach_count")
  engagementCount       Int          @default(0) @map("engagement_count")
  scheduleCount         Int          @default(0) @map("schedule_count")
  matchedOperationCount Int          @default(0) @map("matched_operation_count")
  errorCount            Int          @default(0) @map("error_count")
  summary               Json?
  notes                 String?
  startedAt             DateTime     @default(now()) @map("started_at")
  finishedAt            DateTime?    @map("finished_at")

  @@index([startedAt])
  @@map("coach_import_runs")
}

model CoachSyncLog {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  status      String
  totalRows   Int       @default(0) @map("total_rows")
  created     Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  errors      Int       @default(0)
  errorDetail String?   @map("error_detail")
  triggeredBy String    @map("triggered_by")
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([type, startedAt])
  @@map("coach_sync_logs")
}

model SalesRevenueSyncLog {
  id          String   @id @default(uuid()) @db.Uuid
  status      String
  applied     Boolean  @default(false)
  readCount   Int      @default(0) @map("read_count")
  matched     Int      @default(0)
  filled      Int      @default(0)
  changed     Int      @default(0)
  unchanged   Int      @default(0)
  updatedRows Int      @default(0) @map("updated_rows")
  unmatched   Int      @default(0)
  ambiguous   Int      @default(0)
  triggeredBy String   @map("triggered_by")
  detail      Json?
  startedAt   DateTime @default(now()) @map("started_at")

  @@index([startedAt])
  @@map("sales_revenue_sync_logs")
}

model TeamUser {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  email     String
  slackId   String      @map("slack_id")
  team      String?
  role      MemberRole?
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("team_users")
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  content     String
  authorEmail String    @map("author_email")
  authorName  String?   @map("author_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  attachments AnnouncementAttachment[]

  @@index([deletedAt, createdAt])
  @@map("announcements")
}

model AnnouncementAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  size           Int
  data           Bytes
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@map("announcement_attachments")
}

// coach-db 원본 보관용 테이블. 데이터 적재는 scripts/archive-coach-db.ts로만 한다.
// schema에 등록해두지 않으면 prisma migrate dev가 drift로 판단해 DROP 마이그레이션을
// 자동 생성한다 (20260723062051에서 실제로 발생해 20260731에 복원함).
model CoachdbArchiveSnapshot {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceDatabase String    @map("source_database")
  sourceSchema   String    @default("public") @map("source_schema")
  tableCount     Int       @default(0) @map("table_count")
  rowCount       Int       @default(0) @map("row_count")
  status         String    @default("running")
  errorMessage   String?   @map("error_message")
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  rows CoachdbArchiveRow[]

  @@map("coachdb_archive_snapshots")
}

model CoachdbArchiveRow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId  String   @map("snapshot_id") @db.Uuid
  tableSchema String   @map("table_schema")
  tableName   String   @map("table_name")
  rowKey      String   @map("row_key")
  rowData     Json     @map("row_data")
  archivedAt  DateTime @default(now()) @map("archived_at")

  snapshot CoachdbArchiveSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([snapshotId, tableSchema, tableName, rowKey], map: "coachdb_archive_rows_snapshot_table_key_unique")
  @@index([tableSchema, tableName], map: "coachdb_archive_rows_table_idx")
  @@index([snapshotId], map: "coachdb_archive_rows_snapshot_idx")
  @@index([rowData(ops: JsonbOps)], map: "coachdb_archive_rows_data_gin_idx", type: Gin)
  @@map("coachdb_archive_rows")
}

// 강사위키에서 OM이 입력하는 값과 노션 강사 DB 스냅샷을 강사명 기준으로 보관한다.
// 로컬(dev)에서는 .local/instructor-wiki.json, 배포에서는 이 테이블을 쓴다
// (instructorNoteRepositoryFactory가 OPERATION_DATA_SOURCE로 분기).
// notionProfile은 노션에서 가져온 읽기 전용 스냅샷이라 OM 입력 컬럼과 분리해 둔다.
// 같은 컬럼에 섞으면 재수집 때 OM 수정분이 덮이거나 노션 값이 OM 값으로 굳는다.
model InstructorNote {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructorName String    @unique @map("instructor_name")
  displayName    String?   @map("display_name")
  notionId       String?   @map("notion_id")
  partnerId      String?   @map("partner_id")
  notes          String?
  recruitAvoid   Boolean   @default(false) @map("recruit_avoid")
  // 연락처·이메일·생년월일은 개인정보라 DB에 두지 않는다. 로컬(.local) 파일에만 남긴다.
  // notionProfile에도 넣지 않는다 (instructorNotePii.ts에서 걷어냄).
  notionProfile  Json?     @map("notion_profile")
  notionSyncedAt DateTime? @map("notion_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([recruitAvoid], map: "instructor_notes_recruit_avoid_idx")
  @@map("instructor_notes")
}
