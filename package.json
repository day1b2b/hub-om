{
  "name": "hub-om",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:import:operations": "node scripts/import-operations-from-local-json.mjs",
    "db:import:team-members": "node scripts/import-team-members.mjs",
    "db:promote-source-only": "node scripts/promote-source-only-operations.mjs",
    "drive:import:dry-run": "node --experimental-strip-types --experimental-loader ./scripts/ts-loader.mjs scripts/run-drive-import-dry-run.mjs",
    "email:discussion:preview": "node --experimental-strip-types --experimental-loader ./scripts/ts-loader.mjs scripts/preview-email-discussion-read.mjs",
    "export:feedback": "node scripts/export-feedback-pages.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "7.6.0",
    "next": "16.2.2",
    "next-auth": "5.0.0-beta.30",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.2",
    "prisma": "7.6.0",
    "typescript": "5.9.3"
  },
