SAMSUNG_CONTRACT_SHEET_ID=""
SAMSUNG_CONTRACT_SHEET_RANGE="'운영조교/실습코치 계약요청'!A:Q"

# Notion sources for team resource schedules.
# Share each Notion database with the integration token below.
NOTION_TOKEN=""
NOTION_TEAM1_RESOURCE_URL="https://app.notion.com/p/3c7b65b4b6b34bdf886efb40b1982a9d?v=4635e9963bed4e149acdbf66dd8ad4a5&source=copy_link"
NOTION_TEAM1_RESOURCE_DATABASE_ID=""
NOTION_TEAM1_RESOURCE_NAME_PROPERTIES=""
NOTION_TEAM2_RESOURCE_URL=""
NOTION_TEAM2_RESOURCE_DATABASE_ID=""
NOTION_TEAM2_RESOURCE_NAME_PROPERTIES=""

# hub-bot 업무 챗봇 "미로" (Claude API).
# 시트/노션 문서 범위 안에서만 답하는 사내 FAQ 챗봇. 대화 내용은 저장하지 않음.
ANTHROPIC_API_KEY=""
HUB_BOT_MODEL="claude-sonnet-5"
# 전체 운영 프로세스 시트. RANGE는 실제 탭 이름 확인 후 채움 (예: '시트1'!A:Z).
HUB_BOT_PROCESS_SHEET_ID="1EEJh3luKcuMxo9MHAv-byAUPGuylGGVW"
HUB_BOT_PROCESS_SHEET_RANGE=""
# 매뉴얼 Notion 페이지. NOTION_TOKEN(위 팀 리소스용)과 공유되어 있어야 함.
HUB_BOT_MANUAL_NOTION_PAGE_ID="2df4576d6ffa80148fe0db3019335019"
HUB_BOT_CACHE_TTL_MS="900000"

# 코스ID → {고객사, 과정명} 읽기 전용 조회 (GET /api/sales/lookup).
# 만족도 분석기(survey_analysis)가 코스ID 입력 시 고객사·과정명을 자동 채우도록 돕는 조회용.
# 세일즈맵 딜을 새로 긁지 않고 관리자 매출 동기화와 같은 캐시를 재사용한다(매출은 반환 안 함).
# 값이 비면 기능이 꺼진다(survey는 기존 로컬 학습으로 폴백). 실제 토큰은 배포 환경변수로만 주입.
COURSE_LOOKUP_TOKEN=""
# 조회 응답을 기다리는 상한(ms, 기본 6000). 캐시가 비어 딜 전체를 처음 읽는 중이면 이 시간까지만
# 기다리고 {ok:true, found:false, warming:true}로 먼저 답한다(읽기는 뒤에서 계속돼 캐시를 채운다).
COURSE_LOOKUP_DEADLINE_MS=""
