# PostgreSQL connection.
# Do not put real production secrets in this file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/operation_dashboard_dev?schema=public"

# Direct database URL for migration tooling.
# In simple local setups this can match DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/operation_dashboard_dev?schema=public"

# Runtime data source.
# Keep this as db in deployed environments.
# Use "db" for PostgreSQL or "local" for a git-ignored local JSON file.
OPERATION_DATA_SOURCE="db"
OPERATION_DATA_FILE="operations.json"
RESOURCE_READ_CACHE_TTL_MS="300000"

# Optional private source reader module.
# Keep blank in this public repository unless a private runtime package provides it.
OPERATION_SOURCE_READER_MODULE=""

# Slack discussion read-only integration.
# Prefer bot token mode with explicit channel IDs.
SLACK_BOT_TOKEN=""
# Optional fallback for legacy Slack search mode.
SLACK_SEARCH_TOKEN=""
SLACK_DISCUSSION_AFTER_DATE="2026-01-01"
SLACK_DISCUSSION_CHANNELS=""
SLACK_DISCUSSION_TEAM_CHANNELS=""
SLACK_DISCUSSION_COMPANY_ONLY_CHANNELS=""
SLACK_REPORT_CHANNELS=""
SLACK_DISCUSSION_HISTORY_PAGE_LIMIT="5"
SLACK_DISCUSSION_HISTORY_PAGE_SIZE="100"
SLACK_DISCUSSION_LOOKBACK_DAYS="120"
SLACK_DISCUSSION_MAX_SEARCH_RESULTS="8"
SLACK_DISCUSSION_THREAD_CANDIDATE_LIMIT="50"
SLACK_DISCUSSION_THREAD_LIMIT="20"
SLACK_DISCUSSION_WINDOW_MONTHS_BEFORE="3"
SLACK_DISCUSSION_WINDOW_MONTHS_AFTER="2"
SLACK_DISCUSSION_AI_SUMMARY_ENABLED="false"
SLACK_DISCUSSION_AI_SUMMARY_MODEL="gpt-4o-mini"
SLACK_DISCUSSION_AI_SUMMARY_TIMEOUT_MS="8000"

# 운영(OM) 요청 접수/배정 Slack 알림.
# 파트별 채널로 접수 알림을 보내고, 배정 시 같은 스레드에 댓글로 태깅한다.
# 위 SLACK_BOT_TOKEN(스코프 chat:write)을 함께 사용하며, 봇을 각 채널에 초대해야 한다.
# 태깅은 팀원 관리(/admin/users)에 등록된 이메일/이름의 Slack ID로 해석한다.
# 형식: "파트키:채널ID" 쉼표 구분. 파트키는 요청의 구분값에 포함되면 매칭된다(예: 1파트).
SLACK_OM_REQUEST_CHANNELS=""
# 알림 전용 봇 토큰. 미설정 시 위 SLACK_BOT_TOKEN(논의 읽기와 공용)으로 폴백한다.
# 알림 봇이 읽기 봇과 다른 앱이면 이 값에 알림 봇 토큰을 넣어 서로 간섭을 막는다.
SLACK_OM_REQUEST_BOT_TOKEN=""
# 레거시 폴백. 위 봇/채널 미설정 시에만 단일 채널로 발송한다(스레드 댓글 불가).
SLACK_WEBHOOK_URL=""

# 강의 종료 후 담당 OM 개인 DM 알림.
# D+1 = 코스ID·강의관리·만족도 등록 안내, D+7 = 아직 안 된 등록 + 운영 회고 작성 안내.
# 위 SLACK_OM_REQUEST_BOT_TOKEN(없으면 SLACK_BOT_TOKEN) 봇으로 보낸다(chat:write, 필요 시 im:write).
# 시범 운영: 실제로 DM을 받을 이메일만 쉼표로 적는다. 비우면 아무에게도 보내지 않고 미리보기만 된다.
# 전원 발송은 ALL 로 명시한다. 예: "yj.lee@day1company.co.kr" 또는 "ALL"
SLACK_REMINDER_ONLY_EMAILS=""
# 발송 시작일(YYYY-MM-DD, 한국 날짜). 이 날짜 전에는 미리보기만 되고 DM은 한 통도 나가지 않는다.
# 사이트 정식 안내 시점에 맞춰 알림을 자동으로 켜기 위한 값. 비우면 즉시 발송 가능 상태.
SLACK_REMINDER_START_DATE=""
# 1회 실행에서 DM을 보낼 최대 인원. 넘으면 발송하지 않고 경고만 돌려준다.
REMINDER_MAX_DM_PER_RUN="50"
# 같은 날 중복 발송을 막는 로그 파일 경로. 비우면 OS 임시 디렉터리를 쓴다.
REMINDER_SENT_LOG_FILE=""
# DM 안의 회차 링크에 쓰는 앱 주소. 비우면 AUTH_URL, 그다음 배포 주소를 쓴다.
HUB_OM_BASE_URL=""

# Gmail discussion read-only integration.
# Leave service account/private key blank to reuse Google Drive or Calendar credentials.
GMAIL_SERVICE_ACCOUNT_EMAIL=""
GMAIL_PRIVATE_KEY=""
GMAIL_IMPERSONATE_USER=""
GMAIL_DISCUSSION_AFTER_DATE="2026-01-01"
GMAIL_DISCUSSION_MANUAL_ARCHIVE_FILE=""
GMAIL_DISCUSSION_MANUAL_ARCHIVE_UNTIL_DATE=""
GMAIL_DISCUSSION_MAX_RESULTS="8"
GMAIL_DISCUSSION_TEAM_GROUPS=""

# Optional OpenAI-compatible API for higher-quality Slack thread summaries.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Google Calendar read-only integration.
# Calendar entries use calendarId|ownerName and are comma-separated.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY=""
GOOGLE_CALENDAR_IDS=""
GOOGLE_CALENDAR_LOOKBACK_DAYS="14"
GOOGLE_CALENDAR_LOOKAHEAD_DAYS="60"
GOOGLE_CALENDAR_ABSENCE_KEYWORDS="휴가,연차,반차,부재,휴직,오프"

# 운영현황 → 구글 캘린더 쓰기(초대). 위 읽기 전용 서비스계정과는 별개 경로다.
# 서비스계정은 도메인 전체 위임 없이 참석자를 초대할 수 없어 B2B 전용 계정 OAuth를 쓴다.
# 앱은 프로덕션으로 게시해야 refresh token이 만료되지 않는다.
# 자세한 배경: docs/plans/2026-08-19-operations-calendar-reflect.md
GOOGLE_CAL_OAUTH_CLIENT_ID=""
GOOGLE_CAL_OAUTH_CLIENT_SECRET=""
GOOGLE_CAL_OAUTH_REFRESH_TOKEN=""
# 파트별 캘린더 매핑. SLACK_OM_REQUEST_CHANNELS와 같은 "키:값,키:값" 형식이다.
# 예: "1파트:aaa@group.calendar.google.com,2파트:bbb@group.calendar.google.com"
GOOGLE_CAL_PART_CALENDARS=""
# 역반영(구글 → 운영현황)이 훑는 시간 창(분, 기본 60). events.list의 updatedMin에 쓴다.
# 스케줄 주기보다 넉넉하게 두면 실행이 한 번 빠져도 다음 실행이 따라잡는다.
CALENDAR_REVERSE_SYNC_LOOKBACK_MINUTES="60"

# Google Drive read-only import.
# Leave blank to reuse the Google Calendar service account credentials above.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""

# Google Workspace SSO.
# Generate AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional comma-separated allowlist for /admin/database.
# Leave blank to allow all signed-in day1company.co.kr workspace users.
ADMIN_EMAILS=""
# Set true for trusted deployment/runtime hosts managed by Coolify or local dev.
AUTH_TRUST_HOST="true"

# Coach schedule input link. Use {token}; if omitted, the app will not show the outgoing coach URL.
# Example: "https://<skillflo-coach-url>/coach?token={token}"
SKILLFLO_COACH_URL_TEMPLATE=""

# Coach DB sync/admin jobs.
# Use this bearer token for server-to-server sync calls; UI/admin session access still requires ADMIN_EMAILS.
SYNC_API_SECRET=""
BACKUP_API_SECRET=""

# Coach master sync from Notion.
# Reuses NOTION_TOKEN below if NOTION_API_KEY is blank.
COACH_NOTION_DATABASE_ID=""
NOTION_API_KEY=""

# 강사위키 노션 강사 DB 동기화용 데이터베이스 ID.
# 관리자 > 데이터 동기화 > "노션 강사 동기화" 버튼이 이 DB를 읽는다. NOTION_TOKEN 공유 필요.
INSTRUCTOR_NOTION_DATABASE_ID=""

# Coach engagement sync from Google Sheets values API.
# The sheet must be shared with GOOGLE_SERVICE_ACCOUNT_EMAIL.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
COACH_CONTRACT_SHEET_ID=""
COACH_CONTRACT_SHEET_RANGE="'조교실습코치_일반계약요청'!A:Q"

