# One-shot, explicit export/import runner. No HTTP server or application entrypoint.
FROM node:24-alpine AS dependencies
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm run db:generate

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production RUN_DB_MIGRATIONS=false NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache libc6-compat openssl && mkdir /spool && chown node:node /spool && chmod 700 /spool
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json ./
COPY --chown=node:node prisma ./prisma
COPY --chown=node:node src ./src
COPY --chown=node:node scripts ./scripts
USER node
ENTRYPOINT ["node", "--experimental-strip-types", "--experimental-loader", "./scripts/ts-loader.mjs", "scripts/run-mongodb-shadow-job.ts"]
